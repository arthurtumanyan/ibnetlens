# ibsim dialect: free-form node IDs, no GUIDs in the file
switchguid=0x200000
hcaguids=0x100000

Switch	6 "spine1"
[1]	"leaf1"[5]
[2]	"leaf2"[5]

Switch	6 "leaf1"	# "leaf one"
[1]	"node1"[1]	w=4
[2]	"node2"
[5]	"spine1"[1]
[6]	"absent"[1]

Switch	6 "leaf2"
[1]	"node3"
[5]	"spine1"[2]

Hca	2 "node1"
[1]	"leaf1"[1]

Ca	1 "node2"	# "compute node 2"
[1]	"leaf1"[2]

Hca	1 "node3"
[1]	"leaf2"[1]
